# ==============================================================================
# Personnel Certificate Management System - Environment Variables
# Copy this file to .env.local and fill in the values.
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key is used server-side (e.g. in Cron Job API) to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Notifications: Discord Webhook
# Paste your Discord Channel Webhook URL here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Notifications: Resend (Email)
# Get your API key from https://resend.com
RESEND_API_KEY=re_123456789
# Recipient Email for Expiry Alerts (Admin / HR)
ADMIN_EMAIL=admin@example.com
# From email (must be a verified domain in Resend or "onboarding@resend.dev" during testing)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Cron Security (Optional but recommended for Vercel Cron)
CRON_SECRET=your_secure_cron_secret_key_here

# App URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
